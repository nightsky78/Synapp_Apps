{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nightsky78/Synapp_Apps/catalog/schemas/package-manifest.schema.json",
  "title": "Synapp Package Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "app_id", "name", "version", "summary", "description", "publisher", "runtime", "platform_api", "entrypoint", "capabilities", "tools", "ui", "resource_limits"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "1.0.0" },
    "app_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([+-][A-Za-z0-9.-]+)?$" },
    "summary": { "type": "string", "minLength": 1, "maxLength": 160 },
    "description": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 }
      }
    },
    "runtime": { "const": "wasm32-wasip1" },
    "platform_api": { "const": "v1" },
    "entrypoint": { "type": "string", "pattern": "^[A-Za-z0-9_./-]+\\.wasm$" },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/capability" }
    },
    "tools": {
      "type": "array",
      "items": { "$ref": "#/definitions/tool" }
    },
    "ui": { "$ref": "ui-contribution.schema.json" },
    "ui_schemas": { "$ref": "#/definitions/ui_schemas" },
    "resource_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["memory_bytes", "timeout_ms"],
      "properties": {
        "memory_bytes": { "type": "integer", "minimum": 1048576, "maximum": 134217728 },
        "timeout_ms": { "type": "integer", "minimum": 50, "maximum": 5000 }
      }
    }
  },
  "definitions": {
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability", "label", "description", "required", "risk"],
      "properties": {
        "capability": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*:[a-z][a-z0-9_-]*$" },
        "label": { "type": "string", "minLength": 1, "maxLength": 80 },
        "description": { "type": "string", "minLength": 1, "maxLength": 240 },
        "required": { "type": "boolean" },
        "risk": { "enum": ["low", "medium", "high", "critical"] }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description", "input_schema", "output_schema"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$" },
        "description": { "type": "string", "minLength": 1, "maxLength": 240 },
        "input_schema": { "type": "object" },
        "output_schema": { "type": "object" }
      }
    },
    "ui_schemas": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/app_ui_schema" },
      "properties": {
        "main": { "$ref": "#/definitions/app_ui_schema" },
        "settings": { "$ref": "#/definitions/app_ui_schema" }
      }
    },
    "app_ui_schema": {
      "oneOf": [
        { "$ref": "#/definitions/json_schema" },
        { "$ref": "#/definitions/page_layout_schema_envelope" }
      ]
    },
    "page_layout_schema_envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_type", "page_layout_schema"],
      "properties": {
        "schema_type": { "const": "page_layout_schema" },
        "page_layout_schema": { "$ref": "#/definitions/page_layout_schema" }
      }
    },
    "page_layout_schema": {
      "type": "object",
      "additionalProperties": true,
      "required": ["layout", "components"],
      "properties": {
        "layout": { "type": "string", "minLength": 1 },
        "components": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/page_layout_component" }
        }
      }
    },
    "page_layout_component": {
      "type": "object",
      "additionalProperties": true,
      "required": ["kind", "id"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 },
        "initial_view": { "type": "string" },
        "supported_views": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "json_schema": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string" },
        "properties": { "type": "object" }
      }
    }
  }
}