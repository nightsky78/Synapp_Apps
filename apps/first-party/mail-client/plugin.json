{
  "name": "MailClient",
  "version": "2.1.0",
  "description": "Production Synapp mail client. The Wasm module is a pure planner and validator for human UI flows and AI tool invocations; the host owns account settings, protocol I/O, scheduling, and persistence.",
  "executionInterface": {
    "wasmTarget": "wasm32-wasip1",
    "wasmPath": "target/wasm32-wasip1/release/mail_client.wasm",
    "memoryManagement": {
      "returnedStringsAreNullTerminated": true,
      "deallocatorExport": "free_string",
      "inputEncoding": "utf-8-json"
    },
    "requestEnvelope": {
      "$ref": "#/definitions/RequestEnvelope"
    },
    "exports": [
      { "name": "list_accounts", "description": "List configured mail accounts from host-managed settings without exposing secrets.", "inputSchema": { "$ref": "#/definitions/ListAccountsInput" }, "outputSchema": { "$ref": "#/definitions/ResultEnvelope" } },
      { "name": "get_account_status", "description": "Get sync and connection status for a configured account.", "inputSchema": { "$ref": "#/definitions/GetAccountStatusInput" }, "outputSchema": { "$ref": "#/definitions/ResultEnvelope" } },
      { "name": "list_mailboxes", "description": "List standard and custom folders for one account or the unified inbox.", "inputSchema": { "$ref": "#/definitions/ListMailboxesInput" }, "outputSchema": { "$ref": "#/definitions/ResultEnvelope" } },
      { "name": "read_emails", "description": "Fetch a paginated email list for a mailbox, including thread mode, focused inbox, filters, and sort state.", "inputSchema": { "$ref": "#/definitions/ReadEmailsInput" }, "outputSchema": { "$ref": "#/definitions/ResultEnvelope" } },
      { "name": "search_emails", "description": "Run a full-text mail search with structured filters.", "inputSchema": { "$ref": "#/definitions/SearchEmailsInput" }, "outputSchema": { "$ref": "#/definitions/ResultEnvelope" } },
      { "name": "get_email", "description": "Fetch one email with full bodies, attachment metadata, and optional mark-read planning.", "inputSchema": { "$ref": "#/definitions/GetEmailInput" }, "outputSchema": { "$ref": "#/definitions/ResultEnvelope" } },
      { "name": "get_thread", "description": "Fetch a full conversation thread ordered for reading-pane rendering or agent inspection.", "inputSchema": { "$ref": "#/definitions/GetThreadInput" }, "outputSchema": { "$ref": "#/definitions/ResultEnvelope" } },
      { "name": "mark_read", "description": "Mark one or more emails read or unread.", "inputSchema": { "$ref": "#/definitions/MarkReadInput" }, "outputSchema": { "$ref": "#/definitions/ResultEnvelope" } },
      { "name": "flag_email", "description": "Flag or unflag emails for follow-up.", "inputSchema": { "$ref": "#/definitions/FlagEmailInput" }, "outputSchema": { "$ref": "#/definitions/ResultEnvelope" } },
      { "name": "draft_email", "description": "Create a draft with rich body content, recipients, attachments, and signature metadata.", "inputSchema": { "$ref": "#/definitions/DraftEmailInput" }, "outputSchema": { "$ref": "#/definitions/ResultEnvelope" } },
      { "name": "update_draft", "description": "Update an existing draft in the host draft store.", "inputSchema": { "$ref": "#/definitions/UpdateDraftInput" }, "outputSchema": { "$ref": "#/definitions/ResultEnvelope" } },
      { "name": "discard_draft", "description": "Delete a draft and clear local compose state.", "inputSchema": { "$ref": "#/definitions/DiscardDraftInput" }, "outputSchema": { "$ref": "#/definitions/ResultEnvelope" } },
      { "name": "send_email", "description": "Send a draft through the selected account with undo-send handling.", "inputSchema": { "$ref": "#/definitions/SendEmailInput" }, "outputSchema": { "$ref": "#/definitions/ResultEnvelope" } },
      { "name": "reply_email", "description": "Compose or send a reply or reply-all from an existing message.", "inputSchema": { "$ref": "#/definitions/ReplyEmailInput" }, "outputSchema": { "$ref": "#/definitions/ResultEnvelope" } },
      { "name": "forward_email", "description": "Compose or send a forward with explicit recipients and message note.", "inputSchema": { "$ref": "#/definitions/ForwardEmailInput" }, "outputSchema": { "$ref": "#/definitions/ResultEnvelope" } },
      { "name": "move_email", "description": "Move emails to another mailbox or custom folder.", "inputSchema": { "$ref": "#/definitions/MoveEmailInput" }, "outputSchema": { "$ref": "#/definitions/ResultEnvelope" } },
      { "name": "delete_email", "description": "Move emails to Trash or permanently delete them.", "inputSchema": { "$ref": "#/definitions/DeleteEmailInput" }, "outputSchema": { "$ref": "#/definitions/ResultEnvelope" } },
      { "name": "archive_email", "description": "Move emails into the Archive mailbox.", "inputSchema": { "$ref": "#/definitions/ArchiveEmailInput" }, "outputSchema": { "$ref": "#/definitions/ResultEnvelope" } },
      { "name": "create_folder", "description": "Create a custom folder in an account mailbox tree.", "inputSchema": { "$ref": "#/definitions/CreateFolderInput" }, "outputSchema": { "$ref": "#/definitions/ResultEnvelope" } },
      { "name": "rename_folder", "description": "Rename an existing custom folder.", "inputSchema": { "$ref": "#/definitions/RenameFolderInput" }, "outputSchema": { "$ref": "#/definitions/ResultEnvelope" } },
      { "name": "delete_folder", "description": "Delete a custom folder, optionally forcing when children or messages exist.", "inputSchema": { "$ref": "#/definitions/DeleteFolderInput" }, "outputSchema": { "$ref": "#/definitions/ResultEnvelope" } },
      { "name": "get_unread_count", "description": "Return unread counters per mailbox for one account or the unified inbox.", "inputSchema": { "$ref": "#/definitions/GetUnreadCountInput" }, "outputSchema": { "$ref": "#/definitions/ResultEnvelope" } },
      { "name": "create_rule", "description": "Create a mail automation rule with ordered conditions and actions.", "inputSchema": { "$ref": "#/definitions/CreateRuleInput" }, "outputSchema": { "$ref": "#/definitions/ResultEnvelope" } },
      { "name": "list_rules", "description": "List mail rules for an account.", "inputSchema": { "$ref": "#/definitions/ListRulesInput" }, "outputSchema": { "$ref": "#/definitions/ResultEnvelope" } },
      { "name": "delete_rule", "description": "Delete a stored mail automation rule.", "inputSchema": { "$ref": "#/definitions/DeleteRuleInput" }, "outputSchema": { "$ref": "#/definitions/ResultEnvelope" } },
      { "name": "schedule_send", "description": "Queue a draft for future delivery.", "inputSchema": { "$ref": "#/definitions/ScheduleSendInput" }, "outputSchema": { "$ref": "#/definitions/ResultEnvelope" } },
      { "name": "cancel_scheduled_send", "description": "Cancel a queued send job and restore draft editability.", "inputSchema": { "$ref": "#/definitions/CancelScheduledSendInput" }, "outputSchema": { "$ref": "#/definitions/ResultEnvelope" } }
    ]
  },
  "semanticInterface": {
    "tools": [
      { "name": "list_accounts", "description": "Inspect which user-approved accounts exist and which one is the default.", "category": "query", "capability": "mail:read" },
      { "name": "get_account_status", "description": "Inspect account health, sync freshness, and connection state.", "category": "query", "capability": "mail:read" },
      { "name": "list_mailboxes", "description": "List folders and unread counts for navigation or planning moves.", "category": "query", "capability": "mail:read" },
      { "name": "read_emails", "description": "Read a paginated mailbox view with structured filters and threading options.", "category": "query", "capability": "mail:read" },
      { "name": "search_emails", "description": "Search across accounts and folders with structured filters.", "category": "query", "capability": "mail:read" },
      { "name": "get_email", "description": "Retrieve one message body, headers, and attachments.", "category": "query", "capability": "mail:read" },
      { "name": "get_thread", "description": "Load an entire conversation thread.", "category": "query", "capability": "mail:read" },
      { "name": "mark_read", "description": "Mark messages read or unread.", "category": "mutation", "capability": "mail:read" },
      { "name": "flag_email", "description": "Flag messages for follow-up or clear the flag.", "category": "mutation", "capability": "mail:organize" },
      { "name": "draft_email", "description": "Create a new rich-text draft.", "category": "mutation", "capability": "mail:draft" },
      { "name": "update_draft", "description": "Revise an existing draft.", "category": "mutation", "capability": "mail:draft" },
      { "name": "discard_draft", "description": "Delete a draft and abandon compose state.", "category": "mutation", "capability": "mail:draft" },
      { "name": "send_email", "description": "Send a draft using the selected account.", "category": "mutation", "capability": "mail:send" },
      { "name": "reply_email", "description": "Reply or reply-all to a message, as draft or immediate send.", "category": "mutation", "capability": "mail:send" },
      { "name": "forward_email", "description": "Forward a message with explicit recipients.", "category": "mutation", "capability": "mail:send" },
      { "name": "move_email", "description": "Move messages between folders.", "category": "mutation", "capability": "mail:organize" },
      { "name": "delete_email", "description": "Trash or permanently delete messages.", "category": "mutation", "capability": "mail:organize" },
      { "name": "archive_email", "description": "Archive selected messages.", "category": "mutation", "capability": "mail:organize" },
      { "name": "create_folder", "description": "Create a custom folder.", "category": "mutation", "capability": "mail:organize" },
      { "name": "rename_folder", "description": "Rename a custom folder.", "category": "mutation", "capability": "mail:organize" },
      { "name": "delete_folder", "description": "Delete a custom folder.", "category": "mutation", "capability": "mail:organize" },
      { "name": "get_unread_count", "description": "Get unread counts per folder.", "category": "query", "capability": "mail:read" },
      { "name": "create_rule", "description": "Create an automation rule.", "category": "mutation", "capability": "mail:organize" },
      { "name": "list_rules", "description": "List automation rules.", "category": "query", "capability": "mail:organize" },
      { "name": "delete_rule", "description": "Delete an automation rule.", "category": "mutation", "capability": "mail:organize" },
      { "name": "schedule_send", "description": "Schedule a draft for future delivery.", "category": "mutation", "capability": "mail:send" },
      { "name": "cancel_scheduled_send", "description": "Cancel a queued send job.", "category": "mutation", "capability": "mail:send" }
    ]
  },
  "hostEffects": {
    "required": [
      "AccountCredentialRead",
      "AccountCredentialWrite",
      "ImapFetch",
      "ImapSync",
      "SmtpSend",
      "ContactLookup",
      "NotifyUser",
      "ScheduleJob",
      "CancelJob",
      "StorePlatformSecret",
      "MailStoreRead",
      "MailStoreWrite",
      "MailStoreDelete"
    ],
    "notes": "Mail account secrets and OAuth state are host-managed. The Wasm module validates requests, normalizes payloads, and returns effect plans; it never performs direct IMAP/SMTP/OAuth traffic."
  },
  "definitions": {
    "RequestEnvelope": {
      "type": "object",
      "additionalProperties": true,
      "required": ["context"],
      "properties": {
        "context": {
          "type": "object",
          "additionalProperties": false,
          "required": ["user_id", "permission", "available_effects"],
          "properties": {
            "user_id": { "type": "string", "minLength": 1 },
            "permission": { "type": "string", "enum": ["none", "read", "draft", "send", "organize"] },
            "available_effects": { "type": "array", "items": { "type": "string" } },
            "agent_id": { "type": "string" },
            "request_id": { "type": "string" }
          }
        }
      }
    },
    "ResultEnvelope": {
      "type": "object",
      "oneOf": [
        {
          "type": "object",
          "required": ["ok"],
          "properties": {
            "ok": {
              "type": "object",
              "required": ["operation", "status", "data", "host_effects"],
              "properties": {
                "operation": { "type": "string" },
                "status": { "type": "string", "enum": ["accepted"] },
                "data": { "type": "object" },
                "host_effects": { "type": "array", "items": { "$ref": "#/definitions/HostEffect" } },
                "warnings": { "type": "array", "items": { "$ref": "#/definitions/Warning" } }
              }
            }
          }
        },
        {
          "type": "object",
          "required": ["err"],
          "properties": {
            "err": { "$ref": "#/definitions/Error" }
          }
        }
      ]
    },
    "HostEffect": {
      "type": "object",
      "required": ["effect", "intent", "payload", "idempotency_key"],
      "properties": {
        "effect": { "type": "string" },
        "intent": { "type": "string" },
        "payload": { "type": "object" },
        "idempotency_key": { "type": "string" }
      }
    },
    "Warning": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" }
      }
    },
    "Error": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" },
        "details": { "type": "object" }
      }
    },
    "MailAccountSummary": { "type": "object" },
    "MailAccountStatus": { "type": "object" },
    "Mailbox": { "type": "object" },
    "Pagination": { "type": "object" },
    "SortSpec": { "type": "object" },
    "SearchFilters": { "type": "object" },
    "EmailPageSnapshot": { "type": "object" },
    "SearchSnapshot": { "type": "object" },
    "EmailMessage": { "type": "object" },
    "DraftDocument": { "type": "object" },
    "MailRule": { "type": "object" },
    "ListAccountsInput": { "allOf": [ { "$ref": "#/definitions/RequestEnvelope" }, { "type": "object", "properties": { "snapshot": { "type": "array", "items": { "$ref": "#/definitions/MailAccountSummary" } }, "refresh": { "type": "boolean" } } } ] },
    "GetAccountStatusInput": { "allOf": [ { "$ref": "#/definitions/RequestEnvelope" }, { "type": "object", "required": ["account_id"], "properties": { "account_id": { "type": "string" }, "snapshot": { "$ref": "#/definitions/MailAccountStatus" }, "refresh": { "type": "boolean" } } } ] },
    "ListMailboxesInput": { "allOf": [ { "$ref": "#/definitions/RequestEnvelope" }, { "type": "object", "properties": { "account_id": { "type": "string" }, "snapshot": { "type": "array", "items": { "$ref": "#/definitions/Mailbox" } }, "include_favorites": { "type": "boolean" }, "refresh": { "type": "boolean" } } } ] },
    "ReadEmailsInput": { "allOf": [ { "$ref": "#/definitions/RequestEnvelope" }, { "type": "object", "required": ["mailbox_id"], "properties": { "account_id": { "type": "string" }, "mailbox_id": { "type": "string" }, "pagination": { "$ref": "#/definitions/Pagination" }, "sort": { "$ref": "#/definitions/SortSpec" }, "filters": { "$ref": "#/definitions/SearchFilters" }, "thread_view": { "type": "boolean" }, "focused_inbox": { "type": "boolean" }, "snapshot": { "$ref": "#/definitions/EmailPageSnapshot" }, "refresh": { "type": "boolean" } } } ] },
    "SearchEmailsInput": { "allOf": [ { "$ref": "#/definitions/RequestEnvelope" }, { "type": "object", "required": ["query"], "properties": { "query": { "type": "string" }, "pagination": { "$ref": "#/definitions/Pagination" }, "filters": { "$ref": "#/definitions/SearchFilters" }, "snapshot": { "$ref": "#/definitions/SearchSnapshot" }, "refresh": { "type": "boolean" } } } ] },
    "GetEmailInput": { "allOf": [ { "$ref": "#/definitions/RequestEnvelope" }, { "type": "object", "required": ["email_id"], "properties": { "email_id": { "type": "string" }, "account_id": { "type": "string" }, "snapshot": { "$ref": "#/definitions/EmailMessage" }, "mark_read": { "type": "boolean" }, "refresh": { "type": "boolean" } } } ] },
    "GetThreadInput": { "allOf": [ { "$ref": "#/definitions/RequestEnvelope" }, { "type": "object", "required": ["thread_id"], "properties": { "thread_id": { "type": "string" }, "account_id": { "type": "string" }, "snapshot": { "type": "array", "items": { "$ref": "#/definitions/EmailMessage" } }, "refresh": { "type": "boolean" } } } ] },
    "MarkReadInput": { "allOf": [ { "$ref": "#/definitions/RequestEnvelope" }, { "type": "object", "required": ["email_ids", "read"], "properties": { "email_ids": { "type": "array", "items": { "type": "string" }, "minItems": 1, "maxItems": 250 }, "read": { "type": "boolean" }, "account_id": { "type": "string" }, "mailbox_id": { "type": "string" } } } ] },
    "FlagEmailInput": { "allOf": [ { "$ref": "#/definitions/RequestEnvelope" }, { "type": "object", "required": ["email_ids", "flagged"], "properties": { "email_ids": { "type": "array", "items": { "type": "string" }, "minItems": 1, "maxItems": 250 }, "flagged": { "type": "boolean" }, "account_id": { "type": "string" } } } ] },
    "DraftEmailInput": { "allOf": [ { "$ref": "#/definitions/RequestEnvelope" }, { "type": "object", "required": ["draft"], "properties": { "draft": { "$ref": "#/definitions/DraftDocument" }, "autocomplete_recipients": { "type": "boolean" } } } ] },
    "UpdateDraftInput": { "allOf": [ { "$ref": "#/definitions/RequestEnvelope" }, { "type": "object", "required": ["draft"], "properties": { "draft": { "$ref": "#/definitions/DraftDocument" } } } ] },
    "DiscardDraftInput": { "allOf": [ { "$ref": "#/definitions/RequestEnvelope" }, { "type": "object", "required": ["draft_id"], "properties": { "draft_id": { "type": "string" }, "account_id": { "type": "string" } } } ] },
    "SendEmailInput": { "allOf": [ { "$ref": "#/definitions/RequestEnvelope" }, { "type": "object", "required": ["draft_id", "account_id"], "properties": { "draft_id": { "type": "string" }, "account_id": { "type": "string" }, "undo_window_seconds": { "type": "integer", "enum": [0, 5, 10, 30] }, "notify": { "type": "boolean" } } } ] },
    "ReplyEmailInput": { "allOf": [ { "$ref": "#/definitions/RequestEnvelope" }, { "type": "object", "required": ["email_id", "account_id"], "properties": { "email_id": { "type": "string" }, "account_id": { "type": "string" }, "body_html": { "type": "string" }, "body_text": { "type": "string" }, "include_original": { "type": "boolean" }, "reply_all": { "type": "boolean" }, "send_now": { "type": "boolean" }, "undo_window_seconds": { "type": "integer", "enum": [0, 5, 10, 30] } } } ] },
    "ForwardEmailInput": { "allOf": [ { "$ref": "#/definitions/RequestEnvelope" }, { "type": "object", "required": ["email_id", "account_id", "to"], "properties": { "email_id": { "type": "string" }, "account_id": { "type": "string" }, "to": { "type": "array" }, "cc": { "type": "array" }, "bcc": { "type": "array" }, "note_html": { "type": "string" }, "note_text": { "type": "string" }, "send_now": { "type": "boolean" }, "undo_window_seconds": { "type": "integer", "enum": [0, 5, 10, 30] } } } ] },
    "MoveEmailInput": { "allOf": [ { "$ref": "#/definitions/RequestEnvelope" }, { "type": "object", "required": ["email_ids", "destination_mailbox_id"], "properties": { "email_ids": { "type": "array", "items": { "type": "string" }, "minItems": 1, "maxItems": 250 }, "destination_mailbox_id": { "type": "string" }, "account_id": { "type": "string" } } } ] },
    "DeleteEmailInput": { "allOf": [ { "$ref": "#/definitions/RequestEnvelope" }, { "type": "object", "required": ["email_ids"], "properties": { "email_ids": { "type": "array", "items": { "type": "string" }, "minItems": 1, "maxItems": 250 }, "account_id": { "type": "string" }, "permanent": { "type": "boolean" } } } ] },
    "ArchiveEmailInput": { "allOf": [ { "$ref": "#/definitions/RequestEnvelope" }, { "type": "object", "required": ["email_ids"], "properties": { "email_ids": { "type": "array", "items": { "type": "string" }, "minItems": 1, "maxItems": 250 }, "account_id": { "type": "string" } } } ] },
    "CreateFolderInput": { "allOf": [ { "$ref": "#/definitions/RequestEnvelope" }, { "type": "object", "required": ["account_id", "name"], "properties": { "account_id": { "type": "string" }, "name": { "type": "string", "maxLength": 128 }, "parent_mailbox_id": { "type": "string" }, "favorite": { "type": "boolean" } } } ] },
    "RenameFolderInput": { "allOf": [ { "$ref": "#/definitions/RequestEnvelope" }, { "type": "object", "required": ["account_id", "mailbox_id", "new_name"], "properties": { "account_id": { "type": "string" }, "mailbox_id": { "type": "string" }, "new_name": { "type": "string", "maxLength": 128 } } } ] },
    "DeleteFolderInput": { "allOf": [ { "$ref": "#/definitions/RequestEnvelope" }, { "type": "object", "required": ["account_id", "mailbox_id"], "properties": { "account_id": { "type": "string" }, "mailbox_id": { "type": "string" }, "force": { "type": "boolean" } } } ] },
    "GetUnreadCountInput": { "allOf": [ { "$ref": "#/definitions/RequestEnvelope" }, { "type": "object", "properties": { "account_id": { "type": "string" }, "snapshot": { "type": "array" }, "refresh": { "type": "boolean" } } } ] },
    "CreateRuleInput": { "allOf": [ { "$ref": "#/definitions/RequestEnvelope" }, { "type": "object", "required": ["account_id", "rule"], "properties": { "account_id": { "type": "string" }, "rule": { "$ref": "#/definitions/MailRule" } } } ] },
    "ListRulesInput": { "allOf": [ { "$ref": "#/definitions/RequestEnvelope" }, { "type": "object", "required": ["account_id"], "properties": { "account_id": { "type": "string" }, "snapshot": { "type": "array" }, "refresh": { "type": "boolean" } } } ] },
    "DeleteRuleInput": { "allOf": [ { "$ref": "#/definitions/RequestEnvelope" }, { "type": "object", "required": ["account_id", "rule_id"], "properties": { "account_id": { "type": "string" }, "rule_id": { "type": "string" } } } ] },
    "ScheduleSendInput": { "allOf": [ { "$ref": "#/definitions/RequestEnvelope" }, { "type": "object", "required": ["draft_id", "account_id", "scheduled_for"], "properties": { "draft_id": { "type": "string" }, "account_id": { "type": "string" }, "scheduled_for": { "type": "integer" }, "undo_window_seconds": { "type": "integer", "enum": [0, 5, 10, 30] } } } ] },
    "CancelScheduledSendInput": { "allOf": [ { "$ref": "#/definitions/RequestEnvelope" }, { "type": "object", "required": ["job_id", "account_id"], "properties": { "job_id": { "type": "string" }, "account_id": { "type": "string" }, "draft_id": { "type": "string" } } } ] }
  }
}